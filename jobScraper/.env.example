POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB=
DATABASE_URL=postgres://<user>:<password>@localhost:5432/<db>

# Test database (docker-compose.test.yml)
TEST_DATABASE_URL=postgres://<user>:<password>@localhost:5433/<db>

# Decodo residential proxy (optional — omit to connect directly)
# Format: http://<user>:<password>@gate.decodo.com:10001
# should also verify that your proxy is set to USA
DECODO_PROXY_URL=

# Search options (can also be passed as CLI flags: --keywords, --time-posted, --work-type, --job-type, --jobs)
KEYWORDS=software+engineer
TIME_POSTED=r86400
WORK_TYPE=remote
JOB_TYPE=
NUM_JOBS=10
